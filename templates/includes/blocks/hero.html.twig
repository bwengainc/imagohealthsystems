
{# 1. Tunasoma picha ya background kwa kutumia muundo ule ule wa services [0] #}
{% set bgImageUrl = '' %}
{% if content.background[0] is defined %}
    {% set bgMedia = content.background[0] %}
    {% set bgImageUrl = bgMedia.formats['1920x1097'] ?? bgMedia.url %}
{% else %}
    {% set bgImageUrl = asset('assets/img/home_1/hero_bg.jpeg') %}
{% endif %}

{# 2. Tunasoma picha ya mbele (hero_image) kwa kutumia muundo ule ule wa services [0] #}
{% set fgImageUrl = '' %}
{% if content.hero_image[0] is defined %}
    {% set fgMedia = content.hero_image[0] %}
    {% set fgImageUrl = fgMedia.formats['1071x934'] ?? fgMedia.url %}
{% else %}
    {% set fgImageUrl = asset('assets/img/home_1/hero_img.png') %}
{% endif %}

<!-- Dynamic Sulu Block: ProHealth Hero Section Container -->
<section class="cs_hero cs_style_1">
    {# 💡 Tunatumia content scope moja kwa moja kama services inavyofanya #}
    <div class="cs_hero_wrap cs_bg_filed" data-src="{{ bgImageUrl }}" style="background-image: url('{{ bgImageUrl }}') !important;">
        <div class="container">
            <div class="cs_hero_text">
                
                {% if content.hero_title is defined and content.hero_title is not empty %}
                    <h1 class="cs_hero_title cs_fs_94">
                        {{ content.hero_title }}
                    </h1>
                {% endif %}
                
                {% if content.hero_subtitle is defined and content.hero_subtitle is not empty %}
                    <p class="cs_hero_subtitle cs_fs_20 cs_heading_color">
                        {{ content.hero_subtitle }}
                    </p>
                {% endif %}
                
                {% if content.video_url is defined and content.video_url is not empty %}
                    <div class="cs_hero_btn_wrap">
                        <a href="{{ content.video_url }}" class="cs_video_open cs_heading_color cs_text_btn_2 cs_fs_20">
                            <span class="cs_text_btn_icon">
                                <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://w3.org">
                                    <path d="M42.739 7.26089C32.8938 -2.48797 17.0097 -2.40994 7.26088 7.43526C-2.42029 17.2121 -2.42029 32.9623 7.26088 42.7392C17.1061 52.488 32.9902 52.41 42.739 42.5648C52.4202 32.788 52.4202 17.0377 42.739 7.26089ZM25 48.0713C12.2783 48.0713 1.92868 37.7217 1.92868 25C1.92868 12.2782 12.2782 1.9288 25 1.9288C37.7217 1.9288 48.0712 12.2784 48.0712 25.0001C48.0712 37.7218 37.7216 48.0713 25 48.0713Z" fill="currentColor"/>
                                    <path d="M38.5996 24.1265V24.1277L18.2308 12.368C17.7487 12.0897 17.1322 12.2548 16.8539 12.737C16.7655 12.8901 16.7189 13.0637 16.7189 13.2405V36.7598C16.7191 37.3164 17.1707 37.7676 17.7273 37.7672C17.9041 37.7671 18.0778 37.7206 18.2309 37.6322L38.5997 25.8725C39.0819 25.5943 39.2471 24.9778 38.9689 24.4956C38.8803 24.3423 38.753 24.215 38.5996 24.1265Z" fill="currentColor"/>
                                </svg>
                            </span>
                            <span class="cs_text_btn_text">
                                {{ content.video_text|default("See how we work"|trans) }}
                            </span>
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    {# Foreground Image yenye muundo ule ule wa picha yako #}
    <!--<img src="{{ fgImageUrl }}" alt="{{ content.hero_title|default('Hero Image')|striptags }}" class="cs_hero_img">-->
</section>
