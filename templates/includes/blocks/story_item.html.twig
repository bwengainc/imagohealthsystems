<!-- Start Brand Story Section -->
<div class="cs_height_72 cs_height_lg_50"></div>
<section class="cs_about cs_style_1 services_bg">
  <div class="container">
    <div class="row align-items-center flex-lg-row flex-column-reverse cs_gap_y_40">
      <div class="col-lg-7">
        <div class="cs_about_img">
{% if content.story_image|default([])|length > 0 %}
    {% set media = content.story_image[0] %}
    {% set bgUrl = media.formats['881x579']|default(media.url) %}
{% else %}
    {% set bgUrl = 'assets/img/story_image/banner_img.png' %}
{% endif %}
<img src="{{ bgUrl }}" alt="Imago Health Systems">
          <div class="cs_about_mini_img">
            <!--<img src="{{ asset('assets/img/home_1/about_mini.svg') }}" alt="Mini" class="cs_rotate_animation">
            <img src="{{ asset('assets/img/icons/tick.svg') }}" alt="Right" class="cs_right_icon">-->
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="cs_about_content">
          <div class="cs_section_heading cs_style_1">
          <div class="cs_height_70 cs_height_lg_50"></div>
            <h2 class="cs_section_title cs_fs_72 m-0" style="color:#F8F9FB !important;">
            {% if content.story_title is defined and content.story_title is not empty %}{{ content.story_title|raw }}{% else %}Brand Story{% endif %}
            </h2>
            <div class="cs_height_5"></div>
            <!--<h3 class="cs_section_subtitle text-uppercase cs_accent_color cs_semibold m-0 cs_fs_32">
              IMAGO HEALTH SYSTEMS
            </h3>-->
          </div>
          <div class="cs_height_72 cs_height_lg_50"></div>
          
             {% if content.story_text is defined and content.story_text is not empty %}
                <!--<h3 class="cs_normal cs_fs_32 cs_body_color">{#{ item.story_title }#}</h3>-->
                <p class="m-0" style="color:#F8F9FB !important;">{{ content.story_text|raw }}{% else %}Brand Story text here{% endif %}</p>
                
                <div class="col-lg-12">
                 <div class="cs_height_18"></div>
                {% if content.brand_story_link is defined and content.brand_story_link is not empty %}
                {% set page = sulu_content_load(content.brand_story_link) %}
                {% set brand_link = sulu_content_path(page.content.url) %}

                {% else %}
                              {% set brand_link = '#' %}
                          {% endif %}

                 <a href="{{ brand_link }}" class="cs_text_btn_2 cs_fs_20">
                 {% if content.continue_button is defined and content.continue_button is not empty %} 
                  <button class="cs_btn cs_style_1"><span>{{ content.continue_button|raw }}{% else %}{% endif %}</span></button>
                  </a>
                </div>
                

                </div>

        </div>
      </div>
    </div>
  </div>
  <div class="cs_height_72 cs_height_lg_50"></div>
</section>
<!-- End Brand Story Section -->
