
 <div class="cs_height_200 cs_height_xl_150 cs_height_lg_110"></div>

<!-- Start Testimonial Section -->
<section class="cs_bg_filed" data-src="{{ asset('http://imagohealthsystems.local/uploads/media/1626x760/09/29-banner_bg_2.png?v=1-0') }}">
  <div class="cs_height_190 cs_height_xl_145 cs_height_lg_105"></div>
  <div class="container">
    <div class="cs_section_heading cs_style_1">
      <h3 class="cs_section_subtitle text-uppercase cs_accent_color cs_semibold m-0 cs_accent_color cs_fs_32">
        {#% if content.title is defined and content.title is not empty %}{{ content.title }}{% else %}TESTIMONIALS{% endif %#}
      </h3>
      <div class="cs_height_5"></div>
      <h2 class="cs_section_title cs_fs_72 m-0">
        {% if content.subtitle is defined and content.subtitle is not empty %}{{ content.subtitle|raw }}{% else %}What Our Patients Say <br>About Us{% endif %}
      </h2>
    </div>
    <div class="cs_height_70 cs_height_lg_50"></div>
    <div class="cs_testimonial_carousel cs_gap_20 position-relative">
      <div class="row">
        <div class="col-lg-10 offset-lg-2">
          <div class="cs_slider_activate">
            
            {# MAIN TESTIMONIAL CAROUSEL LOOP #}
            {% if content.testimonials is defined and content.testimonials is not empty %}
              {% for testimonial in content.testimonials %}
                
                {% set itemRating = testimonial.rating|default(5) + 0 %}
                <div class="cs_slide">
                  <div class="cs_testimonial cs_style_3 cs_radius_20 cs_white_bg text-center">
                    <div class="cs_testimonial_img">
                      {% if testimonial.image is defined and testimonial.image is not empty %}
                        {% set imageId = testimonial.image.id is defined ? testimonial.image.id : testimonial.image %}
                        {% set media = sulu_resolve_media(imageId, app.request.locale) %}
                        <img src="{{ media.thumbnails['sulu-240x']|default(asset('assets/img/home_4/avatar_placeholder.png')) }}" alt="{{ testimonial.name|default('Avatar') }}">
                      {% else %}
                        {# Fallback template pattern rotating avatar files 1 and 2 to match your theme structure #}
                        <img src="{{ asset('assets/img/home_3/testimonial_img_' ~ (loop.index is odd ? 1 : 2) ~ '.png') }}" alt="Avatar">
                      {% endif %}
                    </div>
                    <h2 class="cs_testimonial_avatar cs_fs_24 cs_semibold">
                      {{ testimonial.name|default(testimonial.title|default('ANONYMOUS'))|upper }}
                    </h2>
                    
                    <!-- Dynamic Star Ratings Matrix -->
                    <div class="cs_rating cs_accent_color_rating" data-rating="{{ itemRating }}">
                      <div class="cs_rating_bg">
                        {% for i in 1..5 %}
                          <i class="fa-regular fa-star"></i>
                        {% endfor %}
                      </div>
                      <div class="cs_rating_percentage">
                        {% for i in 1..5 %}
                          {% if i <= itemRating %}
                            <i class="fa-solid fa-star"></i>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                    
                    <div class="cs_testimonial_text cs_fs_20">
                      {{ testimonial.text|default(testimonial.comment|default(''))|raw }}
                    </div>
                  </div>
                </div>

              {% endfor %}
            {% endif %}

          </div>
        </div>
      </div>
      <div class="cs_pagination cs_style_1"></div>
      <div class="cs_slider_navigation cs_style_1">
        <!--<div class="cs_slider_prev cs_center"><img src="{{ asset('assets/img/icons/left_arrow_blue.svg') }}" alt="Prev"></div>
        <div class="cs_slider_next cs_center"><img src="{{ asset('assets/img/icons/right_arrow_blue.svg') }}" alt="Next"></div>-->
        <div class="cs_slider_prev cs_center">
  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://w3.org">
