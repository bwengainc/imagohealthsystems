  </svg>
</div>
<div class="cs_slider_next cs_center">
  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://w3.org">
    <path d="M9 5L16 12L9 19" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</div>

      </div>
    </div>
  </div>
