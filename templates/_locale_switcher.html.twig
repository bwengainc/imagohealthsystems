<div class="language">
    {% if localizations is defined and localizations|length > 1 %}
        <div class="language-switcher">
            <ul class="locale-list">
                <li class="locale-item">
                    {# Display Active Current Locale Selection with Downward Arrow #}
                    {% set current_flag = asset('assets/images/languages/' ~ app.request.locale ~ '.png') %}
                    <a href="#" class="locale-link active" onclick="return false;">
                        <img src="{{ current_flag }}" class="flag-icon" alt="{{ app.request.locale|upper }}">
                        <span>{{ app.request.locale|upper }}</span>
                        <span class="dropdown-arrow"></span>
                    </a>
                    
                    {# Hidden Hover Secondary Navigation Submenu Box #}
                    <ul class="locale-submenu">
                        {% for localization in localizations %}
                            {% if localization.locale != app.request.locale %}
                                {% set target_flag = asset('assets/images/languages/' ~ localization.locale ~ '.png') %}
                                <li>
                                    <a href="{{ localization.url }}">
                                        <img src="{{ target_flag }}" class="flag-icon" alt="{{ localization.locale|upper }}">
                                        <span>{{ localization.locale|upper }}</span>
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </li>
            </ul>
        </div>
    {% endif %}
</div>


