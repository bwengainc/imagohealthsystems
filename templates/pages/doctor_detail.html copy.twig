                {% if content.schedules is defined and content.schedules is not empty %}
                    {% for shift in content.schedules %}
                        {% if shift.type == 'schedule_item' %}
                            <li>
                              <span>{{ shift.day|default }}</span>
                              <span><i class="fa-regular fa-clock"></i> {{ shift.time|default }}</span>
                            </li>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <li>
                      <span>Monday</span>
                      <span><i class="fa-regular fa-clock"></i> 09.00-12.00</span>
                    </li>
                    <li>
                      <span>Wednesday</span>
                      <span><i class="fa-regular fa-clock"></i> 15.00-18.00</span>
                    </li>
                {% endif %}
              </ul>
