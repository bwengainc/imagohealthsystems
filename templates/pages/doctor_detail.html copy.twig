{% extends "base.html.twig" %}

{% block content %}

    <!-- Start Page Heading -->
    <div class="cs_height_170"></div>
    
    {# Determine background source image dynamically #}
    {% if content.header_bg_image is defined and content.header_bg_image is not empty and content.header_bg_image.url is defined %}
        {% set heading_bg = content.header_bg_image.url %}
    {% else %}
        {% set heading_bg = asset('assets/img/doctors/page_heading_bg.jpeg') %}
    {# Substitute with your global layout background image path if applicable #}
    {% endif %}

    <div class="cs_page_heading cs_bg_filed" data-src="{{ heading_bg }}">
      <div class="container">
        <div class="cs_page_heading_in">
          
          {# DYNAMIC BREADCRUMBS MODULE #}
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="{{ sulu_content_path('/') }}">Home</a>
            </li>
            
            <li class="breadcrumb-item">
              {% if content.parent_page_link is defined and content.parent_page_link is not empty %}
                  {# Resolves dynamically to whichever parent listing page is picked #}
                  <a href="{{ sulu_content_path(content.parent_page_link) }}">Doctors</a>
              {% else %}
                  {# Hardcoded route path fallback strategy #}
                  <a href="{{ sulu_content_path('/doctors') }}">Doctors</a>
              {% endif %}
            </li>
            
            <li class="breadcrumb-item active">
              {# Displays the active doctor page title object dynamically #}
              {{ content.title }}
            </li>
          </ol>
          
          {# ACTIONABLE SEARCH SUBMISSION ROUTE #}
          {% set search_action_url = content.parent_page_link is defined and content.parent_page_link is not empty 
              ? sulu_content_path(content.parent_page_link) 
              : sulu_content_path('/doctors') %}

          <form action="{{ search_action_url }}" method="GET" class="cs_search_form">
            <input type="text" name="search" placeholder="Search Doctors" value="{{ app.request.query.get('search') }}">
            <button type="submit" class="cs_search_btn">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.07914 0C3.62682 0 0 3.62558 0 8.07641C0 12.5272 3.62682 16.1599 8.07914 16.1599C9.98086 16.1599 11.7299 15.4936 13.1122 14.3875L16.4775 17.7498C16.6473 17.9126 16.8741 18.0024 17.1094 18C17.3446 17.9975 17.5695 17.9032 17.736 17.737C17.9025 17.5708 17.9972 17.3461 17.9999 17.111C18.0027 16.8758 17.9132 16.6489 17.7506 16.4789L14.3853 13.1148C15.4928 11.7308 16.16 9.97968 16.16 8.07641C16.16 3.62558 12.5315 0 8.07914 0ZM8.07914 1.79517C11.561 1.79517 14.3625 4.59577 14.3625 8.07641C14.3625 11.557 11.561 14.3647 8.07914 14.3647C4.59732 14.3647 1.79575 11.557 1.79575 8.07641C1.79575 4.59577 4.59732 1.79517 8.07914 1.79517Z" fill="currentColor"/>
              </svg>                
            </button>
          </form>

        </div>
      </div>
    </div>
    <!-- End Page Heading -->

{# 1. FIXED: Added explicit index [0] array traversal matching your signature style #}
    {% if content.banner_bg_svg|default([])|length > 0 %}
        {% set bg_media = content.banner_bg_svg[0] %}
        {% set bg_src = bg_media.url %}
    {% else %}
        {% set bg_src = asset('assets/img/doctors/banner_bg.svg') %}
    {% endif %}

    

    <!-- Start Doctor Details -->
    <div class="cs_doctor_details">
      <div class="cs_doctor_details_bg cs_bg_filed" data-src="{{ bg_src  }}"></div>
      <div class="cs_height_85"></div>
      
      <div class="container">
        <div class="row">
      
         {# LEFT COLUMN AREA #}
<div class="col-lg-5">
  <div class="cs_single_doctor overflow-hidden cs_radius_20">
    
    {% if content.doctor_image[0] is defined %}
        {% set media = content.doctor_image[0] %}
        
        {# FIXED: Properly look inside the formats mapping array for the specific resolution url #}
        {% set imageSrc = media.formats['600x400'].url is defined and media.formats['600x400'].url is not empty 
            ? media.formats['600x400'].url 
            : media.url %}
            
        <img src="{{ imageSrc }}" alt="{{ content.title }}" class="w-100">
    {% else %}
        <img src="{{ asset('assets/img/doctors/doctor_details.jpeg') }}" alt="Doctor Fallback" class="w-100">
    {% endif %}

  </div>
</div>


            <div class="cs_height_94 cs_height_lg_60"></div>
            
