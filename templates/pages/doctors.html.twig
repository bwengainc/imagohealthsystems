{% extends "base.html.twig" %}

{% block content %}

    {# 1. FIXED: Added explicit index [0] array traversal matching your signature style #}
    {% if content.banner_bg_svg|default([])|length > 0 %}
        {% set bg_media = content.banner_bg_svg[0] %}
        {% set bg_src = bg_media.url %}
    {% else %}
        {% set bg_src = asset('assets/img/doctors/banner_bg.svg') %}
    {% endif %}

    {% if content.banner_image|default([])|length > 0 %}
        {% set side_media = content.banner_image[0] %}
        {% set side_img_url = side_media.url %}
    {% else %}
        {#% set side_img_url = asset('assets/img/doctors/banner_img.png') %#}
        {% set side_img_url = null %}
    {% endif %}

    <!-- Start Banner  -->
    <!--<section class="cs_banner cs_style_5 cs_bg_filed" data-src="{{ bg_src }}">-->
    <section class="cs_banner cs_style_5 cs_bg_filed breadcum_bg">
      <div class="cs_banner_img">
       <!-- <img src="{{ side_img_url }}" alt="Banner Image">-->
      </div>
      <div class="container">
        <div class="cs_banner_text">
          <h2 class="cs_banner_title cs_fs_72">{{ content.title|raw }}</h2>
          <p class="cs_banner_subtitle cs_fs_20 mb-0 cs_heading_color">
              {{ content.banner_subtitle|default('The list of certified doctors with years of professional experiences')|raw }}
          </p>
        </div>
      </div>
    </section>
    <!-- End Banner  -->

    <!-- Start All Doctors -->
    <div class="cs_height_65"></div>
    <div class="container">
      <div class="cs_doctors_heading">
        <div class="cs_isotop_filter cs_style1">
          <p class="mb-0">{% trans  %}Sort by{% endtrans %}</p>
          <ul class="cs_mp0">
            <li class="active"><a href="#" data-filter="*">{% trans  %} All {% endtrans %}</a></li>
            <li><a href="#" data-filter=".emergency">{% trans  %}Emergency Opthalmologist{% endtrans %}</a></li>
            <li><a href="#" data-filter=".opthalmologist">{% trans  %}Opthalmologist{% endtrans %}</a></li>
            <li><a href="#" data-filter=".others">{% trans  %}Others{% endtrans %}</a></li>
          </ul>
        </div>
        <div class="cs_view_box">
          <span>{% trans  %}Showing{% endtrans %} {{ content.doctors|default([])|length }} {% trans  %}items{% endtrans %}</span>
          <div class="cs_view_box_in">
            <button type="button" class="cs_grid_view active">
              <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://w3.org">
                <path d="M0 11.8571H11.8571V0H0V11.8571ZM1.5625 1.5625H10.2948V10.2948H1.5625V1.5625ZM13.1429 0V11.8571H25V0H13.1429ZM23.4375 10.2948H14.7052V1.5625H23.4375V10.2948ZM0 25H11.8571V13.1429H0V25ZM1.5625 14.7052H10.2948V23.4375H1.5625V14.7052ZM13.1429 25H25V13.1429H13.1429V25ZM14.7052 14.7052H23.4375V23.4375H14.7052V14.7052Z" fill="#CFAC62"/>
              </svg>                
            </button>
            <button type="button" class="cs_list_view">
              <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://w3.org">
                <path d="M0 11.8571H12.2396V0H0V11.8571ZM1.6129 1.5625H10.6267V10.2946H1.6129V1.5625ZM0 25H12.2396V13.1429H0V25ZM1.6129 14.7052H10.6267V23.4375H1.6129V14.7052ZM25 0.85022V2.41272H14.3731V0.85022H25ZM14.3731 9.44458H25V11.0071H14.3731V9.44458ZM14.3731 5.1475H25V6.71H14.3731V5.1475ZM14.3731 13.9929H25V15.5554H14.3731V13.9929ZM14.3731 22.5873H25V24.1498H14.3731V22.5873ZM14.3731 18.2902H25V19.8527H14.3731V18.2902Z" fill="currentColor"/>
              </svg>                
            </button>
          </div>
        </div>
      </div>
      
      <div class="cs_height_65"></div>
      
      <div class="cs_isotop cs_style1 cs_grid_view_wrap cs_isotop_col_3 cs_has_gutter_24">
        <div class="cs_grid_sizer"></div>
        
        {# Loop ya kupitia kila Daktari mmoja mmoja #}
        {% if content.doctors is defined and content.doctors is not empty %}
            {% for doctor in content.doctors %}
                {% if doctor.type == 'doctor_item' %}
                    
                    <div class="cs_isotop_item {{ doctor.filter_class|default('emergency') }}">
                      <div class="cs_team cs_style_1 cs_type_2 text-center cs_radius_20 overflow-hidden">
                        
                        <div class="cs_member_img">
                {# Kutengeneza Link ya kuingia ndani ya daktari huyu kupitia single_page_selection #}
                          {% if doctor.details_link.url is defined and doctor.details_link is not empty %}
                              {% set doc_link = sulu_content_path(doctor.details_link.url) %}
                          {% else %}
                              {% set doc_link = '#' %}
                          {% endif %}

                {% if doctor.details_link is defined and doctor.details_link is not empty %}
                {% set page = sulu_content_load(doctor.details_link) %}
                {% set doc_link = sulu_content_path(page.content.url) %}

                {% else %}
                              {% set doc_link = '#' %}
                          {% endif %}

                          <a href="{{ doc_link }}" class="d-block">
                              {# FIXED: Added explicit [0] index selection check for child block items #}
                              {% if doctor.image|default([])|length > 0 %}
                                  {% set doc_media = doctor.image[0] %}
                                  <img src="{{ doc_media.url }}" alt="Doctor">
                              {% else %}
                                  <img src="{{ asset('assets/img/doctors/doctor_1.png') }}" alt="Doctor">
                              {% endif %}
                          </a>
                          <div class="cs_label cs_white_color cs_accent_bg">
                              {{ doctor.department_name|default('Emergency Department') }}
                          </div>
                        </div>                
                        <div class="cs_team_meta cs_white_bg">
                          <div>
                            <h3 class="cs_member_name cs_fs_32">
                                <a href="{{ doc_link }}">{{ doctor.name|default('Dr. Lisa Chen, MD') }}</a>
                            </h3>
                            <p class="cs_member_designation cs_heading_color cs_medium">
                                {{ doctor.designation|default('Emergency Medicine Specialist') }}
                            </p>
                            <p class="cs_member_description">
                                {{ doctor.description|default }}
                            </p>
                          </div>
                          <div>
                            <div class="cs_social_links">
                              {% if doctor.facebook_url is not empty %}
                                  <a href="{{ doctor.facebook_url }}" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
                              {% endif %}
                              {% if doctor.linkedin_url is not empty %}
                                  <a href="{{ doctor.linkedin_url }}" target="_blank"><i class="fa-brands fa-linkedin-in"></i></a>
                              {% endif %}
                              {% if doctor.twitter_url is not empty %}
                                  <a href="{{ doctor.twitter_url }}" target="_blank"><i class="fa-brands fa-twitter"></i></a>
                              {% endif %}
                            </div>
                          </div>
                        </div>
                        
                      </div>
                    </div><!-- .cs_isotop_item -->
                    
                {% endif %}
            {% endfor %}
        {% endif %}

      </div>
    </div>
    <!-- End All Doctors -->

{% endblock %}
