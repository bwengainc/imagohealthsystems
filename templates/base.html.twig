{# Global Floating WhatsApp Button #}
{% set account = webspaceSettings.content.account.entity|default %}
{% if account and account.mainPhone is not empty %}
    {# 1. Strip all spaces, dashes, and plus signs #}
    {% set raw_phone = account.mainPhone|replace({' ': '', '+': '', '-': ''}) %}
    
    {# 2. Force international country code (e.g., if number starts with 07..., change to 2557...) #}
    {% if raw_phone|first == '0' %}
        {% set whatsapp_number = '255' ~ raw_phone|slice(1) %}
    {% else %}
        {% set whatsapp_number = raw_phone %}
    {% endif %}
    
    {# FIXED: Added the mandatory forward slash right after wa.me #}
    <a href="https://wa.me/+{{ whatsapp_number }}?text=Hello!%20I%20have%20a%20question." 
       class="cs_whatsapp_floating_btn" 
       target="_blank" 
