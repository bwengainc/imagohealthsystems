        {% block header %}
        <!-- Start Header Section -->
    <header class="cs_site_header cs_style1 cs_sticky_header cs_heading_color cs_gescout_sticky cs_gescout_show">
    <!--<header class="cs_site_header cs_style1 cs_sticky_header cs_white_color cs_gescout_sticky cs_gescout_show">-->
      <div class="cs_main_header">
        <div class="container">
          <div class="cs_main_header_in">
            <div class="cs_main_header_left">
    {% set account = webspaceSettings.content.account.entity|default %}
    {% if account is defined and account.logo is defined %}
    {% set logo = sulu_resolve_media(account.logo.id, app.request.locale) %}
              <a class="cs_site_branding" href="{{ sulu_content_root_path() }}" title="{{ account.name }}" rel="home">
            <img src="{{ logo.thumbnails['173x'] }}"  alt="{{ logo.title }}" 
             title="{{ logo.description|default(logo.title) }}">
              </a>
    {% else %}
    <a href="{{ sulu_content_root_path() }}" rel="home"><img src="/assets/logo_website.png" alt="Default Logo">
    </a>
    {% endif %}

    {% set currentPath = app.request.pathinfo %}

<nav class="cs_nav">
    <ul class="cs_nav_list">
        {% for item in sulu_navigation_root_tree('main', 3) %}
            {% set itemUrl = sulu_content_path(item.url) %}
            {% set hasChildren = item.children|length > 0 %}
            {% set isActive = (currentPath == itemUrl) or (currentPath starts with itemUrl ~ '/') %}
            
            <li class="{% if hasChildren %}menu-item-has-children{% endif %}{% if isActive %} active{% endif %}">
                <a href="{{ itemUrl }}">{{ item.title }}</a>
                
                {% if hasChildren %}
                    <ul>
                        {% for child in item.children %}
                            {% set childUrl = sulu_content_path(child.url) %}
                            {% set childHasChildren = child.children|length > 0 %}
                            {% set childActive = (currentPath == childUrl) or (currentPath starts with childUrl ~ '/') %}
                            
                            <li class="{% if childHasChildren %}menu-item-has-children{% endif %}{% if childActive %} active{% endif %}">
                                <a href="{{ childUrl }}">{{ child.title }}</a>
                                
                                {% if childHasChildren %}
                                    <ul>
                                        {% for subChild in child.children %}
                                            {% set subChildUrl = sulu_content_path(subChild.url) %}
                                            {% set subChildActive = (currentPath == subChildUrl) or (currentPath starts with subChildUrl ~ '/') %}
                                            
                                            <li{% if subChildActive %} class="active"{% endif %}>
                                                <a href="{{ subChildUrl }}">{{ subChild.title }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>
            </div>
            <div class="cs_main_header_right">
             {% include '_locale_switcher.html.twig' %}
              <div class="cs_toolbox">
                
                
              </div>
            </div>
          </div>
        </div>
      </div>
