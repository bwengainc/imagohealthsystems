<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <!-- 💡 Imebadilishwa kufuata muundo kamili wa Services Block inayofanya kazi kwako -->
    <block name="blocks" default-type="hero">
        
        <types>
            
            <type name="hero">
                <meta>
                    <title lang="en">Hero Section</title>
                </meta>
                <properties>
                    
                    <property name="hero_title" type="text_line" mandatory="true">
                        <meta><title lang="en">Headline</title></meta>
                    </property>
                    
                    <property name="hero_subtitle" type="text_area" mandatory="true">
                        <meta><title lang="en">Subtitle Text</title></meta>
                    </property>
                   <property name="video_url" type="text_line">
    <meta>
        <title lang="en">Video URL (YouTube/Vimeo)</title>
        <title lang="de">Video URL</title>
    </meta>
</property>

                    <property name="video_text" type="text_line">
                    <meta><title lang="en">Video Button Text</title></meta>
                </property>

<property name="background" type="media_selection" minOccurs="0" maxOccurs="1">
    <meta>
        <title lang="en">Background Image</title>
        <title lang="de">Hintergrundbild</title>
    </meta>
</property>

<property name="hero_image" type="media_selection" minOccurs="0" maxOccurs="1">
    <meta>
        <title lang="en">Hero Image</title>
        <title lang="de">Hero Bild</title>
    </meta>
</property>
                    
                    
                    
                </properties>
            </type>
            
        </types>
    </block>

</properties>
