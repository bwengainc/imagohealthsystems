<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <block name="blocks" default-type="story_item">
        <meta>
            <title lang="en">Brand Story Block</title>
        </meta>
        <types>
            <type name="story_item">
                <meta>
                    <title lang="en">Brand Story Item</title>
                </meta>
                <properties>
                    <property name="story_title" type="text_line" mandatory="true">
                        <meta>
                            <title lang="en">Story Title</title>
                        </meta>
                    </property>

                    <property name="story_text" type="text_editor">
                        <meta>
                            <title lang="en">Story Text</title>
                        </meta>
                    </property>

                    <property name="story_image" type="media_selection">
                        <meta>
                            <title lang="en">Story Image</title>
                        </meta>
                        <params>
                            <param name="min" value="0"/>
                            <param name="max" value="1"/>
                        </params>
                    </property>

                    <property name="continue_button" type="text_line">
                            <meta>
                                <title lang="en">Continue Reading button</title>
                            </meta>
                        </property>

                    <property name="brand_story_link" type="single_page_selection" colspan="6">
                        <meta><title>Page</title></meta>
                        </property>

                </properties>
            </type>
        </types>
    </block>

</properties>
